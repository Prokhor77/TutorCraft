# Production-окружение TutorCraft. На сервере: cp .env.prod.example /opt/tutorcraft/.env && chmod 600 .env
# Каждый деплой (infra/k8s/apply.sh) превращает файл в Secret tutorcraft-env в k3s. core-api и
# notifier получают его целиком, остальные поды — только свои ключи (infra/k8s/app/*.yaml).
# Правка вступает в силу при следующем деплое или сразу: `infra/k8s/apply.sh` под пользователем
# tutorcraft. Изменённый .env перезапускает поды сам: его хэш стоит в их аннотации.
#
# Значения пишутся БЕЗ кавычек: kubectl --from-env-file, в отличие от compose, их не снимает.
#
# Секреты заполняет infra/deploy/bootstrap-ip.sh — руками их генерировать не нужно.
# Текущий сценарий: голый IP, HTTP, файлы на диске сервера, почта выключена.

# --- Публичный адрес -----------------------------------------------------------------------
# WEB_ORIGIN — проверка Origin у WebSocket и cookie; PUBLIC_BASE_URL — ссылки в письмах/Telegram.
# Схема и порт должны совпадать с тем, что набирает пользователь в адресной строке.
WEB_ORIGIN=http://91.149.179.186
PUBLIC_BASE_URL=http://91.149.179.186

# ⚠ false ОБЯЗАТЕЛЕН при HTTP: браузер молча выбрасывает cookie с флагом Secure, пришедшую
# не по HTTPS, и refresh-токен не сохранится — вход будет слетать через 15 минут.
# Обратная сторона: refresh-cookie и пароли идут по сети открытым текстом. При переезде на
# домен с TLS вернуть true вместе со сменой схемы в двух строках выше.
COOKIE_SECURE=false

# --- SEO (apps/web/docs/seo.md) -----------------------------------------------------------
# PUBLIC_BASE_URL — ещё и канонический адрес сайта (canonical, Open Graph, sitemap.xml).
# Пока сайт на голом IP, поисковики к нему не допускаются автоматически: иначе IP-адрес попадёт
# в индекс и после переезда на домен будет конкурировать с ним как дубль. SEO_INDEXING=true/false
# переопределяет это правило (пусто — автоматически).
SEO_INDEXING=
# Коды подтверждения прав из Яндекс.Вебмастера и Google Search Console (только значение content).
YANDEX_VERIFICATION=
GOOGLE_SITE_VERIFICATION=

# --- PostgreSQL (под postgres-0) -----------------------------------------------------------
# Пароль применяется только при первой инициализации пустого каталога данных.
POSTGRES_DB=tutorcraft
POSTGRES_USER=tutorcraft
POSTGRES_PASSWORD=

# --- MongoDB -------------------------------------------------------------------------------
MONGO_DB=tutorcraft

# --- Redis ---------------------------------------------------------------------------------
REDIS_PASSWORD=

# --- Файлы -----------------------------------------------------------------------------------
# local — файлы и HLS лежат на диске сервера в /opt/tutorcraft/data/files (том files-data в k3s).
# s3 — внешний S3 (Yandex Object Storage / R2, docs/deployment.md): заполнить S3_* ниже.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Kafka ---------------------------------------------------------------------------------
KAFKA_TOPIC_PREFIX=tc

# --- Безопасность ---------------------------------------------------------------------------
# >= 32 символов: openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
JWT_SECRET=
# Ключ шифрования секретов интеграций (AES-GCM): openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# ⚠ После первого запуска не менять: DATA_ENCRYPTION_KEY расшифровывает секреты интеграций
# в БД, смена JWT_SECRET разлогинит всех. Сохранить .env в менеджер паролей.

# --- Главный администратор -------------------------------------------------------------------
# Единственная учётная запись с доступом в /admin. Создаётся при старте core-api; смена
# пароля здесь применяется после перезапуска core-api (его делает apply.sh при изменении .env).
# Без неё при выключенных демо-сидах и почте в систему попасть можно только самрегистрацией.
ADMIN_EMAIL=admin@tutorcraft.local
ADMIN_PASSWORD=

# --- OAuth. Пусто = провайдер выключен --------------------------------------------------------
# Google и Telegram-виджет требуют домена: на голый IP их консоли origin не примут. Оставить пустыми.
GOOGLE_CLIENT_ID=
TELEGRAM_BOT_TOKEN=
# Имя бота без @, например TutorCraft_bot (ведущие @ и https://t.me/ core-api срежет сам).
TELEGRAM_BOT_USERNAME=

# --- Оплата подписки школы (единственный платёж на платформе). Пока только fake -----------------
PAYMENT_PROVIDER=fake

# --- Почта -------------------------------------------------------------------------------------
# Пустой SMTP_HOST выключает email-канал в notifier (internal/config: `Host == "" disables email`).
# Следствие: письма-приглашения и сброс пароля не уходят — ссылку активации остаётся пересылать вручную.
# Порт 465 — TLS с первого байта (SMTPS), любой другой — STARTTLS, если сервер его предлагает.
# Готовые настройки для Gmail / Яндекса / Mail.ru — docs/deployment-ip.md §6.2. У Gmail и Яндекса
# SMTP_FROM должен совпадать с SMTP_USERNAME, иначе письмо отклонят или перепишут отправителя.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=TutorCraft <no-reply@tutorcraft.local>

# --- Go-воркеры ---------------------------------------------------------------------------------
LOG_LEVEL=info
MAX_VIDEO_BYTES=2147483648
TRANSCODE_TIMEOUT=30m
# Сервер общий с confeek — один FFmpeg за раз.
WORKER_CONCURRENCY=1
NOTIFIER_CONCURRENCY=4
# Telegram выключен (нет токена) — long-polling включать нечему.
TELEGRAM_POLLING_ENABLED=false

# --- Сиды демо-данных: в проде всегда выключены (продублировано в infra/k8s/app/core-api.yaml) ----
SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=

# --- Журнал активности (Администрирование → Активность) --------------------------------------
# Необязательно: значения по умолчанию подходят. RETENTION — ISO-8601 (P30D = 30 дней).
# ACTIVITY_LOG_ENABLED=true
# ACTIVITY_LOG_READS=true
# ACTIVITY_LOG_RETENTION=P30D
