# Production-окружение TutorCraft. На сервере: cp .env.prod.example .env && chmod 600 .env, заполнить.
# Файл читают docker-compose.prod.yml (подстановка ${...}) и контейнеры core-api / notifier (env_file).
# Генерация секретов:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-64

# --- Домен ---
# Публичный адрес приложения. Используется для cookie/CSRF (WEB_ORIGIN), ссылок в письмах и Telegram (PUBLIC_BASE_URL).
WEB_ORIGIN=https://tutorcraft.example
PUBLIC_BASE_URL=https://tutorcraft.example
COOKIE_SECURE=true
CORE_PROFILE=prod

# --- PostgreSQL (контейнер tutorcraft_postgres) ---
POSTGRES_DB=tutorcraft
POSTGRES_USER=tutorcraft
POSTGRES_PASSWORD=

# --- MongoDB ---
MONGO_DB=tutorcraft

# --- Redis ---
REDIS_PASSWORD=

# --- S3: внешнее хранилище (ADR-011). Оба адреса — один и тот же публичный HTTPS-endpoint провайдера. ---
# Yandex Object Storage: https://storage.yandexcloud.net, регион ru-central1.
# Бакет: приватный; CORS на PUT/GET с WEB_ORIGIN; публичное чтение только префикса hls/ (ADR-008).
S3_ENDPOINT=https://storage.yandexcloud.net
S3_PUBLIC_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=tutorcraft-prod
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Kafka ---
KAFKA_TOPIC_PREFIX=tc

# --- Безопасность ---
# >= 32 случайных байт:  openssl rand -base64 48
JWT_SECRET=
# Ключ шифрования секретов интеграций (AES-GCM):  openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# --- OAuth. Пусто = провайдер выключен ---
GOOGLE_CLIENT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Платежи: fake | yookassa | stripe ---
PAYMENT_PROVIDER=fake
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Почта (реальный SMTP, TLS/STARTTLS на 587) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=TutorCraft <no-reply@tutorcraft.example>

# --- Go-воркеры ---
LOG_LEVEL=info
MAX_VIDEO_BYTES=2147483648
TRANSCODE_TIMEOUT=30m
# Сервер общий с confeek — один FFmpeg за раз.
WORKER_CONCURRENCY=1
NOTIFIER_CONCURRENCY=4
# Long-polling Telegram включать ровно в одном экземпляре notifier.
TELEGRAM_POLLING_ENABLED=true

# --- Сиды демо-данных: в проде всегда выключены (продублировано в compose) ---
SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=

# --- Образы: тег для отката, по умолчанию latest ---
# TUTORCRAFT_IMAGE_TAG=sha-abc1234
