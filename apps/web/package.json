{
  "name": "@tutorcraft/web",
  "version": "0.1.0",
  "private": true,
  "description": "TutorCraft web app: LMS UI for all roles, SSR storefront and course landings, PWA",
  "engines": {
    "node": ">=22"
  },
  "//overrides": "next тянет собственную вложенную копию postcss (node_modules/next/node_modules/postcss), и уязвимой считается вся линейка <=8.5.22 — патча внутри next@15 нет, npm audit fix предлагает только мажорный прыжок на next@16. Форсируем 8.5.23+ (семвер-патч, API не меняется), иначе `npm audit --audit-level=high` валит CI.",
  "overrides": {
    "postcss": "^8.5.28"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons": "python3 scripts/generate-icons.py",
    "i18n:check": "node scripts/check-i18n.mjs",
    "contrast:check": "node scripts/check-contrast.mjs"
