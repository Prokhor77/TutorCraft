# Скопируйте в .env и заполните. Файл .env не коммитится (NFR-SEC, раздел 0.5 ТЗ).
# Значения ниже — только для локальной разработки.

# --- PostgreSQL ---
POSTGRES_DB=tutorcraft
POSTGRES_USER=tutorcraft
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- MongoDB ---
MONGO_DB=tutorcraft

# --- Redis ---
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Хранилище файлов ---
# local — файлы на диске (в docker — volume file-storage), s3 — S3-совместимое хранилище ниже.
STORAGE_DRIVER=local
# Каталог для local при запуске core-api с хоста; по умолчанию ./data/files.
# В docker compose всегда /data/files (общий volume core-api и media-worker) — здесь не переопределяется.
# STORAGE_LOCAL_ROOT=./data/files

# --- S3 / MinIO (только для STORAGE_DRIVER=s3) ---
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=tutorcraft
S3_REGION=us-east-1
# Адрес S3, который видит браузер (pre-signed URL). Локально — MinIO на хосте.
S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- Kafka ---
KAFKA_TOPIC_PREFIX=tc

# --- Безопасность ---
# >= 32 случайных байт в base64:  openssl rand -base64 48
JWT_SECRET=
# Ключ шифрования секретов интеграций в БД (NFR-SEC-06):  openssl rand -base64 32
DATA_ENCRYPTION_KEY=
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# --- Главный администратор платформы ---
# Единственная учётная запись с доступом к администрированию (все школы). Создаётся/обновляется при старте core-api;
# смена пароля здесь вступает в силу после перезапуска. Пароль: >= 10 символов, буквы и цифры.
ADMIN_EMAIL=admin@tutorcraft.local
ADMIN_PASSWORD=

# --- OAuth (гибрид, ADR-002). Пусто = провайдер выключен ---
GOOGLE_CLIENT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Платежи. PAYMENT_PROVIDER: fake | yookassa | stripe ---
PAYMENT_PROVIDER=fake
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Почта (локально — Mailpit, UI http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=TutorCraft <no-reply@tutorcraft.local>

# --- Go-воркеры (services/media-worker, services/notifier) ---
# В docker compose адреса переопределяются (kafka:9092, http://s3:8333); значения ниже — для запуска с хоста.
KAFKA_BROKERS=localhost:29092
S3_ENDPOINT=http://localhost:9000
LOG_LEVEL=info
# media-worker: лимит исходного видео (байты, 2 GiB), таймаут FFmpeg, число параллельных задач (<= числа партиций).
MAX_VIDEO_BYTES=2147483648
TRANSCODE_TIMEOUT=30m
WORKER_CONCURRENCY=2
# notifier: параллельные консьюмеры; long-polling Telegram-бота включать ровно в одном экземпляре.
NOTIFIER_CONCURRENCY=4
TELEGRAM_POLLING_ENABLED=true

# --- Web ---
NEXT_PUBLIC_WS_URL=ws://localhost:8090/ws
PUBLIC_BASE_URL=http://localhost:3000

# --- Сиды демо-данных (только dev) ---
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=
